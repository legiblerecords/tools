{
  "name": "@legiblerecords/legible",
  "version": "0.1.0",
  "description": "Legible Records in JavaScript: expand and generate short-form schemas, lint published types, check compatibility. Built from the Rust tools as WebAssembly.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiblerecords/tools.git",
    "directory": "packages/legible"
  },
  "keywords": ["legible-records", "json-schema", "security", "schema"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/web/legible_records_wasm.d.ts",
      "node": "./dist/node/legible_records_wasm.cjs",
      "default": "./dist/web/legible_records_wasm.js"
    }
  },
  "types": "./dist/web/legible_records_wasm.d.ts",
  "files": ["dist/", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "sh build.sh",
    "test": "node --test test/"
  }
}
