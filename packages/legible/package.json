{
  "name": "@legiblerecords/legible",
  "version": "0.3.0",
  "description": "Legible Records in JavaScript: expand and generate short-form schemas, lint published types, check compatibility, and pack, verify and encrypt bundles. Built from the Rust tools as WebAssembly.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legiblerecords/tools.git",
    "directory": "packages/legible"
  },
  "keywords": [
    "legible-records",
    "json-schema",
    "security",
    "schema",
    "age"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/legible_records_wasm.d.cts",
        "default": "./dist/legible_records_wasm.cjs"
      },
      "default": {
        "types": "./dist/legible_records_wasm.d.ts",
        "default": "./dist/legible_records_wasm.js"
      }
    }
  },
  "types": "./dist/legible_records_wasm.d.ts",
  "bin": {
    "legible": "bin/legible.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "sh build.sh",
    "test": "node --test test/vectors.test.mjs test/cli.test.mjs"
  },
  "dependencies": {
    "age-encryption": "^0.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
